# AutoBuild platform environment template.
# Copy to .env.local for local development. Never commit a filled file.
# Only NEXT_PUBLIC_* values reach the browser. Treat everything else as server-only.

# ── Web app: public (exposed to the browser) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Web app: server-only ────────────────────────────────────────────────────
BACKEND_ORIGIN=http://localhost:8000
BACKEND_API_SECRET=
ANTHROPIC_API_KEY=
AUTOBUILD_RESEARCH_OPENAI_KEY=
AUTOBUILD_RESEARCH_MODEL=
# Local dev only. Leave unset outside a local run.
AUTOBUILD_PROFILE_STORE_PATH=
# Lowercase SHA-256 hex digest of a 32-96 character printable ASCII credential.
# Unset keeps the workspace routes and the research API closed.
AUTOBUILD_V1_PILOT_SHA256=

# ── Backend (Railway / local) ───────────────────────────────────────────────
PORT=8000
MODEL_PATH=model.zip
# Not yet read from the environment; the key is currently hardcoded in
# backend/main.py and backend/weather.py and must be moved here (and rotated).
OPENWEATHER_API_KEY=

# ── Bench-only Pod settings ─────────────────────────────────────────────────
# Keep these in an owner-only launcher file OUTSIDE the repo, not in .env.
# See docs/pod-camera-local.md and docs/pod-video-local.md.
# AUTOBUILD_LOCAL_CAMERA_ENABLED=
# AUTOBUILD_CAMERA_VIEWER=
# AUTOBUILD_CAMERA_OVERHEAD=
# AUTOBUILD_LOCAL_VIDEO_ENABLED=
# AUTOBUILD_VIDEO_HLS_JS=
# AUTOBUILD_VIDEO_PORT=
# AUTOBUILD_VIDEO_REGISTRY=
# AUTOBUILD_VIDEO_VIEWER=
# AUTOBUILD_VIDEO_OVERHEAD=
# AUTOBUILD_VIDEO_SIDE=
